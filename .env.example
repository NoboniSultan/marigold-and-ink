# Copy this file to .env and fill in real values. Never commit .env.
# The server validates these at startup and refuses to boot if any are missing.

# --- App ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent (tests force silent)
LOG_LEVEL=info

# --- Database (Docker Compose: dev on host port 5434, test on 5433) ---
DATABASE_URL=postgres://marigold:marigold@localhost:5434/marigold_dev
TEST_DATABASE_URL=postgres://marigold:marigold@localhost:5433/marigold_test

# --- Redis (optional until a feature uses it) ---
REDIS_URL=redis://localhost:6379

# --- CORS: comma-separated list of allowed origins ---
CORS_ORIGINS=http://localhost:5173

# --- Auth: secret used to sign sessions/tokens. At least 32 characters. ---
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# --- Admin seed (milestone 3) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Stripe, TEST MODE ONLY (milestone 7) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
