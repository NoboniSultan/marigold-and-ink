# Copy this file to .env and fill in real values. Never commit .env.
# The server validates these at startup and refuses to boot if any are missing.

# --- App ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent (tests force silent)
LOG_LEVEL=info

# --- Database (Docker Compose: dev on host port 5434, test on 5433) ---
DATABASE_URL=postgres://marigold:marigold@localhost:5434/marigold_dev
TEST_DATABASE_URL=postgres://marigold:marigold@localhost:5433/marigold_test

# --- Redis (optional until a feature uses it) ---
REDIS_URL=redis://localhost:6379

# --- CORS + CSRF: comma-separated list of allowed browser origins ---
# State-changing requests from any other Origin are rejected (403 CSRF_ORIGIN_MISMATCH).
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Secret used to sign the session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Optional (defaults shown). bcrypt cost factor: 12. Session lifetime after last activity: 7 days.
# BCRYPT_ROUNDS=12
# SESSION_MAX_AGE_DAYS=7

# --- Rate limits (optional; defaults shown) ---
# RATE_LIMIT_LOGIN_MAX=10              # failed logins per IP + email ...
# RATE_LIMIT_LOGIN_WINDOW_MINUTES=15   # ... per 15 minutes
# RATE_LIMIT_REGISTER_MAX=5            # sign-up code requests per IP ...
# RATE_LIMIT_REGISTER_WINDOW_MINUTES=60

# --- Reverse proxies in front of the app (0 locally, 1 on Render) ---
# TRUST_PROXY=0

# --- Admin seed (npm run seed). Password must meet the policy: 12+ chars, at most 72 bytes ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=Admin

# --- Commission business settings (required; set by the owner, no defaults in code) ---
# Deposit charged when a quote is accepted, as a percent of the total (up to 2 decimals).
DEPOSIT_PERCENT=
# Revisions included in every new commission.
COMMISSION_REVISION_LIMIT=

# --- Accounts: email sign-up codes and Google sign-in (see docs/setup-google-and-email.md) ---
# The site's address. Locally that's Vite (the browser's origin), not the API port.
# PUBLIC_URL=http://localhost:5173

# Sign-up codes: 'log' prints them in this terminal (development only, the default outside
# production); 'resend' sends real email (needs a domain verified in Resend, and
# PUBLIC_URL above, for the links in emails).
# EMAIL_TRANSPORT=log
# RESEND_API_KEY=re_...
# EMAIL_FROM=Marigold & Ink <hello@mail.noboni.art>

# "Continue with Google": both values from Google Cloud Console, plus PUBLIC_URL above.
# Leave empty to hide the button.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# --- Stripe payments, TEST MODE ONLY (see "Payments" in the README) ---
# Leave the two secrets empty to switch payments off. Live keys (sk_live_) are refused.
# The secret key: Stripe Dashboard → Developers → API keys (test mode).
# STRIPE_SECRET_KEY=sk_test_...
# The webhook signing secret that `stripe listen` prints when it starts.
# STRIPE_WEBHOOK_SECRET=whsec_...
# The currency the shop charges in (the owner chose USD). Needs PUBLIC_URL above too.
PAYMENT_CURRENCY=usd

# --- Giving: trees through Digital Humani (docs/setup-digital-humani.md) ---
# Leave the API key empty to switch giving off. Needs payments (above) switched on.
# From my.digitalhumani.com → Developer (sandbox keys while payments are in test mode).
# DIGITALHUMANI_API_KEY=
# DIGITALHUMANI_ENTERPRISE_ID=
# The planting project (e.g. a One Tree Planted project from Digital Humani's list).
# DIGITALHUMANI_PROJECT_ID=
# sandbox only for now: 'production' is refused while Stripe is in test mode.
# DIGITALHUMANI_ENVIRONMENT=sandbox
# The share of each commission's full price that goes to trees (the owner chose 25).
# DONATION_PERCENT=25
