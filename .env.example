# Copy this file to .env and fill in real values. Never commit .env.
# The server validates these at startup and refuses to boot if any are missing.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (Docker Compose: dev on 5432, test on 5433) ---
DATABASE_URL=postgres://marigold:marigold@localhost:5432/marigold_dev
TEST_DATABASE_URL=postgres://marigold:marigold@localhost:5433/marigold_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CORS: comma-separated list of allowed origins ---
CORS_ORIGINS=http://localhost:5173

# --- Auth (milestone 3; mechanism decided in an ADR) ---
# AUTH_SECRET=replace-with-a-long-random-string

# --- Admin seed (milestone 3) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Stripe, TEST MODE ONLY (milestone 7) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
